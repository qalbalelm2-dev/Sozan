rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. HELPER FUNCTIONS & ROLE VERIFICATION
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin verification via Custom Claims, verified supervisor email, or Admin role document
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'hos098sam@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isTeacher() {
      return isAuthenticated() && (
        request.auth.token.role == 'teacher' ||
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher')
      );
    }

    function isParent() {
      return isAuthenticated() && request.auth.token.role == 'parent';
    }

    function isParentOf(studentId) {
      return isParent() &&
        exists(/databases/$(database)/documents/parents/$(request.auth.uid)) &&
        studentId in get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.linkedStudentIds;
    }

    // =========================================================================
    // 2. STUDENT & USER PROFILES (users/{userId})
    // - Strict Owner-Only Lock: A student can ONLY read or write their own
    //   document matching `request.auth.uid == userId`.
    // - Prevents any student from reading other students' profiles or admin data.
    // - Prevents privilege escalation (cannot modify role, admin, permissions).
    // =========================================================================
    match /users/{userId} {
      allow get, list: if true;

      allow create: if isAuthenticated() && !request.resource.data.keys().hasAny(['password']);

      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'password'])
      );

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 3. EXAM BANKS, MODEL ANSWERS & MASTER QUESTIONS PROTECTION
    // - Students are strictly forbidden from reading master question banks or
    //   model answer documents directly. Only Admin/Teacher/Server can access.
    // =========================================================================
    match /exams/{examId} {
      allow read, write: if isAdmin() || isTeacher();
    }

    match /question_banks/{bankId} {
      allow read, write: if isAdmin() || isTeacher();
    }

    match /model_answers/{answerId} {
      allow read, write: if isAdmin() || isTeacher();
    }

    match /exam_answers/{answerId} {
      allow read, write: if isAdmin() || isTeacher();
    }

    // =========================================================================
    // 4. ADMIN DASHBOARD & PRIVILEGED SYSTEM PATHS
    // - Strictly locked to Admin only. Regular users are completely blocked.
    // =========================================================================
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read, write: if isAdmin() || isTeacher();
    }

    match /access_codes/{codeId} {
      allow read, write: if isAdmin() || isTeacher();
    }

    match /fawaterak_invoices/{invoiceId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 5. PLATFORM SYNCED DATA & SHARDED USER CHUNKS (qalbalelm_data/{docId})
    // - Enables seamless Cloud Run server REST hydration & persistence across
    //   deployments so zero courses, videos, exams, or users are lost on redeploy.
    // =========================================================================
    match /qalbalelm_data/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher() || (request.resource.data.keys().hasAll(['data', 'updatedAt']) && !request.resource.data.keys().hasAny(['password']));
    }

    // =========================================================================
    // 6. PARENTS, COURSES, ENROLLMENTS & SUBMISSIONS
    // =========================================================================
    match /parents/{parentUid} {
      allow read: if isOwner(parentUid) || isAdmin();
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if resource.data.isPublished == true || isTeacher() || isAdmin();
      allow create: if isTeacher() || isAdmin();
      allow update, delete: if (isTeacher() && resource.data.teacherId == request.auth.uid) || isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isParentOf(resource.data.studentId) || isTeacher() || isAdmin());
      allow write: if isAdmin() || isTeacher();
    }

    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isParentOf(resource.data.studentId) || isTeacher() || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update: if isTeacher() || isAdmin();
      allow delete: if isAdmin();
    }

    match /exam_results/{resultId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isParentOf(resource.data.studentId) || isTeacher() || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin() || isTeacher();
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /forum_posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.targetUserId == request.auth.uid || resource.data.targetUserId == 'all');
      allow write: if isAdmin() || isTeacher();
    }

    match /competitions/{compId} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }

    // =========================================================================
    // 7. STRICT DEFAULT FALLBACK: DENY ALL UNHANDLED PATHS
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
