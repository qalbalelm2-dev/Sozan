rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // User avatar uploads: max 5MB, image types only
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && 
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Student exam & homework PDF submissions: max 15MB
    match /submissions/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && 
        request.resource.size < 15 * 1024 * 1024;
    }

    // Course educational media and materials (Protected: only Admin, teachers, or authorized enrolled students with verified custom claims)
    match /courses/{courseId}/{allFiles=**} {
      allow read: if isAdmin() || (isAuthenticated() && (request.auth.token.role == 'teacher' || (request.auth.token.enrolledCourses != null && courseId in request.auth.token.enrolledCourses)));
      allow write: if isAdmin() || (isAuthenticated() && request.auth.token.role == 'teacher');
    }

    // Fallback: Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
